/*
 * pg_config.h (generated by CMake from pg_config.h.in): the configure-time facts
 * that copied pgvector/PostgreSQL code checks. ARKIVECTOR-owned.
 */
#ifndef AV_PG_CONFIG_H
#define AV_PG_CONFIG_H

/* We expose the PostgreSQL 17 API surface (headers copied from REL_17_11). */
#define PG_MAJORVERSION "17"
#define PG_MAJORVERSION_NUM 17
#define PG_VERSION "17.11"
#define PG_VERSION_NUM 170011

#define BLCKSZ 8192
#define MAXIMUM_ALIGNOF 8
#define ALIGNOF_SHORT 2
#define ALIGNOF_INT 4
#define ALIGNOF_LONG 8
#define ALIGNOF_DOUBLE 8
#define ALIGNOF_BUFFER 32
#define SIZEOF_VOID_P 8
#define SIZEOF_SIZE_T 8
#define SIZEOF_LONG 8
#define SIZEOF_BOOL 1
#define HAVE_LONG_INT_64 1
#define FLOAT8PASSBYVAL true
#define USE_FLOAT8_BYVAL 1
#define PG_CACHE_LINE_SIZE 128

#cmakedefine HAVE__GET_CPUID 1
#cmakedefine HAVE__GET_CPUID_COUNT 1
#cmakedefine HAVE_XSAVE_INTRINSICS 1
#cmakedefine HAVE__BUILTIN_POPCOUNT 1
#cmakedefine HAVE__BUILTIN_CTZ 1
#cmakedefine HAVE__BUILTIN_CLZ 1

#define HAVE__BUILTIN_OP_OVERFLOW 1
#define HAVE__BUILTIN_TYPES_COMPATIBLE_P 1
#define HAVE__BUILTIN_CONSTANT_P 1
#define HAVE__BUILTIN_UNREACHABLE 1
#define HAVE_FUNCNAME__FUNC 1
#define HAVE_TYPEOF 1
#define HAVE_STDBOOL_H 1

#endif /* AV_PG_CONFIG_H */
