root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 110

# Copied pgvector / PostgreSQL code keeps pgindent style (tabs).
[daemon/src/pgvector/**]
indent_style = tab
tab_width = 4

[*.{py,toml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
